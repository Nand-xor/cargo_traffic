<Page x:Class="cargo_traffic.ClosingOrderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:cargo_traffic"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ClosingOrderPage" ShowsNavigationUI="False">

    <Page.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="10" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Background" Value="#4682B4" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Width" Value="200" />
            <Setter Property="Height" Value="40" />
            <Setter Property="BorderBrush" Value="#4682B4" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" BlurRadius="5" ShadowDepth="2" />
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>
    <Grid Background="#F0F4F7">

        <TextBlock Text="Заказ" FontSize="26" VerticalAlignment="Top" FontWeight="SemiBold" HorizontalAlignment="Left" Margin="284,149,0,0" Height="43" Width="87"/>

        <TextBlock Text="Оплата" FontSize="26" VerticalAlignment="Top" FontWeight="SemiBold" HorizontalAlignment="Left" Margin="283,215,0,0"/>

        <Button Content="Назад" Click="BackButton_Click" Width="180" Height="30" HorizontalAlignment="Left" Margin="10,0,0,30" VerticalAlignment="Bottom"/>
        <Image Margin="10,10,596,271" Source="/logo.png" Stretch="Fill"/>
        <TextBox HorizontalAlignment="Left" Margin="390,215,0,0" Name="PaymentTxtBox" TextWrapping="Wrap" FontSize="26" VerticalAlignment="Top" Width="152" Height="43"/>
        <ComboBox x:Name="OrderComboBox" SelectedItem="{Binding заказ_id}" DisplayMemberPath="id" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Left" Margin="390,151,0,0" VerticalAlignment="Top" Width="152" Height="39"/>
        <Button Content="Закрыть заказ" Click="CloseOrderButton_Click" Width="180" Height="30" HorizontalAlignment="Center" Margin="0,0,0,30" VerticalAlignment="Bottom"/>
    </Grid>
</Page>
