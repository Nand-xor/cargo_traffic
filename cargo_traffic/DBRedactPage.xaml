<Page x:Class="cargo_traffic.DBRedactPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:cargo_traffic"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="DBRedactPage" ShowsNavigationUI="False">
    <Page.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="10" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Background" Value="#4682B4" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Width" Value="150" />
            <Setter Property="Height" Value="40" />
            <Setter Property="BorderBrush" Value="#4682B4" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" BlurRadius="5" ShadowDepth="2" />
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>
    <Grid Background="#F0F4F7">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Image Source="Resources/logo.png" Height="90" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,0,0"/>

        <!-- слева список таблиц, справа сами данные -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Width="200" Margin="10,10,0,10" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Button Content="Водители" Click="DriversBtn_Click"/>
                    <Button Content="Доходы" Click="ProfitBtn_Click"/>
                    <Button Content="Тех. обслуживание" Click="TechServiceBtn_Click"/>
                    <Button Content="Заказы" Click="OrdersBtn_Click"/>
                    <Button Content="Заказы-грузы" Click="OrdersCargosBtn_Click"/>
                    <Button Content="Закупка грузовиков" Click="TrucksPurchaseBtn_Click"/>
                    <Button Content="Работа грузовиков" Click="TrucksOccupancyBtn_Click"/>
                    <Button Content="Клиенты" Click="ClientsBtn_Click"/>
                    <Button Content="Маршруты" Click="RoutesBtn_Click"/>
                    <Button Content="Остатки грузовиков" Click="TruckRemnantsBtn_Click"/>
                    <Button Content="Перевозки" Click="ShipmentsBtn_Click"/>
                    <Button Content="Пользователи" Click="UsersBtn_Click"/>
                    <Button Content="Статусы заказов" Click="OrdersStatusBtn_Click"/>
                    <Button Content="Тарифы" Click="TariffsBtn_Click"/>
                    <Button Content="точки погрузки" Click="LoadPointsBtn_Click"/>
                    <Button Content="точки разгрузки" Click="UnloadPointsBtn_Click"/>
                    <Button Content="транспортные средства" Click="VehiclesBtn_Click"/>
                </StackPanel>
            </ScrollViewer>

            <DataGrid x:Name="MainDataGrid" Grid.Column="1" Margin="10"/>
        </Grid>

        <!-- кнопки сохранить/добавить/удалить, назад справа -->
        <Grid Grid.Row="2">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                <Button Content="Сохранить изменения" Name="SaveBtn" Click="SaveChanges"/>
                <Button Content="Добавить" Name="AddBtn" Click="AddBtn_Click"/>
                <Button Content="Удалить" Name="DeleteBtn" Click="DeleteChanges"/>
            </StackPanel>
            <Button Content="Назад" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10" Click="GoBack"/>
        </Grid>
    </Grid>
</Page>
