<Page x:Class="cargo_traffic.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:cargo_traffic"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="LoginPage">

    <Grid Background="#F0F8FF">
        <Image Source="Resources/logo.png" Width="200" Height="175" Margin="10" VerticalAlignment="Top"/>

        <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Height="200" Margin="0,172,0,0">
            <TextBlock Text="Вход" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>

            <StackPanel Width="300" Margin="0,0,0,10">
                <TextBlock Text="Логин" Foreground="Gray" Margin="0,0,0,5"/>
                <TextBox Name="LoginTxtBox" Height="30" />
            </StackPanel>

            <StackPanel Width="300" Margin="0,0,0,10">
                <TextBlock Text="Пароль" Foreground="Gray" Margin="0,0,0,5"/>
                <PasswordBox Name="PasswordBox" Height="30" />
            </StackPanel>

            <Button Content="Войти" Width="120" Height="40" Margin="0,0,0,0" Click="LoginButton_Click"/>
        </StackPanel>

        <TextBlock Text="© 2023 Cargo Transportation App" HorizontalAlignment="Center" FontSize="12" Foreground="Gray" VerticalAlignment="Bottom" Margin="10"/>
    </Grid>
</Page>
