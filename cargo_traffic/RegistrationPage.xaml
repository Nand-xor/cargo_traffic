<Page x:Class="cargo_traffic.RegistrationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:cargo_traffic"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="RegistrationPage" ShowsNavigationUI="False">

    <Grid Background="#F0F8FF">
        <Image Source="Resources/logo.png" Height="90" Margin="10" VerticalAlignment="Top" HorizontalAlignment="Left"/>

        <!-- форма регистрации -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Регистрация" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>

            <StackPanel Width="300" Margin="0,0,0,10">
                <TextBlock Text="Логин" Foreground="Gray" Margin="0,0,0,5"/>
                <TextBox Name="LoginTxtBox" Height="30" />
            </StackPanel>

            <StackPanel Width="300" Margin="0,0,0,10">
                <TextBlock Text="Пароль" Foreground="Gray" Margin="0,0,0,5"/>
                <PasswordBox Name="PasswordBox" Height="30" />
            </StackPanel>

            <StackPanel Width="300" Margin="0,0,0,10">
                <TextBlock Text="Подтверждение пароля" Foreground="Gray" Margin="0,0,0,5"/>
                <PasswordBox Name="ConfirmPasswordBox" Height="30" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                <Button Content="Зарегистрироваться" Width="170" Height="40" Margin="0,0,10,0" Click="RegisterButton_Click"/>
                <Button Content="Назад" Width="120" Height="40" Click="BackButton_Click"/>
            </StackPanel>
        </StackPanel>

        <TextBlock Text="© 2023 Cargo Transportation App" HorizontalAlignment="Center" FontSize="12" Foreground="Gray" VerticalAlignment="Bottom" Margin="10"/>
    </Grid>
</Page>
