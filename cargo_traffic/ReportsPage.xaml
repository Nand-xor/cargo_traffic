<Page x:Class="cargo_traffic.ReportsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:cargo_traffic"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ReportsPage" ShowsNavigationUI="False">
    <Page.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="10" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Background" Value="#4682B4" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Width" Value="150" />
            <Setter Property="Height" Value="40" />
            <Setter Property="BorderBrush" Value="#4682B4" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" BlurRadius="5" ShadowDepth="2" />
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>
    <Grid Background="#F0F4F7">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Image Source="Resources/logo.png" Height="90" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,0,0"/>
            <TextBlock x:Name="ReportTitleText" FontSize="22" FontWeight="SemiBold" Foreground="#333333"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,10"/>
        </Grid>

        <!-- слева фильтр по датам, справа таблица -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Width="190" Margin="10,10,0,10">
                <TextBlock Text="Период с:" FontSize="14" Foreground="#333333"/>
                <DatePicker x:Name="FromDatePicker" SelectedDateChanged="OnPeriodChanged"/>
                <TextBlock Text="По:" FontSize="14" Foreground="#333333" Margin="0,10,0,0"/>
                <DatePicker x:Name="ToDatePicker" SelectedDateChanged="OnPeriodChanged"/>
                <Button Content="Сбросить период" Width="170" Click="ResetPeriod_Click"/>
            </StackPanel>
            <DataGrid x:Name="ReportGrid" Grid.Column="1" Margin="10" IsReadOnly="True" AutoGenerateColumns="True"/>
        </Grid>

        <!-- итоговая сумма и кнопка назад -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TotalText" FontSize="16" FontWeight="Bold" Foreground="#333333"
                       TextWrapping="Wrap" VerticalAlignment="Center" Margin="10,0,10,10"/>
            <Button Grid.Column="1" Content="Назад" VerticalAlignment="Center" Margin="10" Click="BackButton_Click"/>
        </Grid>
    </Grid>
</Page>
