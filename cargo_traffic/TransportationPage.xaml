<Page x:Class="cargo_traffic.TransportationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:cargo_traffic"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="TransportationPage" ShowsNavigationUI="False">

    <Page.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="10" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Background" Value="#4682B4" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Width" Value="200" />
            <Setter Property="Height" Value="40" />
            <Setter Property="BorderBrush" Value="#4682B4" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" BlurRadius="5" ShadowDepth="2" />
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Page.Resources>
    <Grid Margin="10" Background="#F0F4F7">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="79*"/>
            <ColumnDefinition Width="311*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Заказ:" FontSize="18" VerticalAlignment="Center" FontWeight="SemiBold" HorizontalAlignment="Center"/>
        <ComboBox x:Name="OrderComboBox" SelectedItem="{Binding заказ_id}" DisplayMemberPath="id" Grid.Row="0" Margin="2,15,10,15" Grid.Column="1"/>

        <TextBlock Text="Грузовик:" Grid.Row="1" FontSize="18" VerticalAlignment="Center" FontWeight="SemiBold" HorizontalAlignment="Center"/>
        <ComboBox x:Name="VehicleComboBox" SelectedItem="{Binding грузовой_автомобиль_id}" DisplayMemberPath="грузоподъёмность_в_тоннах" Grid.Row="1" Margin="2,15,10,15" Grid.Column="1"/>

        <TextBlock Text="Водитель:" Grid.Row="2" FontSize="18" VerticalAlignment="Center" FontWeight="SemiBold" HorizontalAlignment="Center"/>
        <ComboBox x:Name="DriverComboBox" SelectedItem="{Binding водитель_id}" DisplayMemberPath="ФИО" Grid.Row="2" Margin="2,15,10,15" Grid.Column="1"/>

        <TextBlock Text="Маршрут:" Grid.Row="3" FontSize="18" VerticalAlignment="Center" FontWeight="SemiBold" HorizontalAlignment="Center"/>
        <ComboBox x:Name="RouteComboBox" SelectedItem="{Binding маршрут_id}" SelectionChanged = "RouteComboBox_SelectionChanged"  DisplayMemberPath="описание" Grid.Row="3" Margin="2,15,10,15" Grid.Column="1"/>
        

        <TextBlock Text="время доставки:" Grid.Row="4" FontSize="18" VerticalAlignment="Center" FontWeight="SemiBold" HorizontalAlignment="Center"/>
        <TextBlock x:Name="DeliveryTimeTxtBlock" Grid.Row="4" Text ="" FontSize="18" FontWeight="SemiBold" Margin="2,15,10,15" Grid.Column="1"/>

        <Button Content="Начать перевозку" Click="RegisterTransportationButton_Click" Grid.Row="6" Width="180" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Column="0" Grid.ColumnSpan="2"/>
        <Button Content="Назад" Click="BackButton_Click" Grid.Row="6" Width="180" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Column="0" Grid.ColumnSpan="1"/>
    </Grid>
</Page>
